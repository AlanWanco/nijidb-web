# 复制为 news-poller.env 后填写，并保持权限 600；不要提交真实值。

# 站点地址与新闻资源密钥（必填）
NIJIDB_BASE_URL=https://your-site.example
NIJIDB_INGEST_API_KEY=change-me

# R2 图片归档（必填；用只允许目标 Bucket 对象读写的专用凭据）
R2_ENDPOINT=https://change-me.r2.cloudflarestorage.com
R2_BUCKET=nijidb
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_PUBLIC_BASE_URL=https://change-me
R2_IMAGE_PREFIX=images

# 轮询节奏：默认只扫官网第一页，篇间 30 秒、图间 10 秒，趟间隔随机 30–60 分钟
NEWS_POLL_MAX_PAGES=1
NEWS_POLL_ARTICLE_DELAY_SECONDS=30
NEWS_POLL_IMAGE_DELAY_SECONDS=10
NEWS_POLL_REST_MIN_MINUTES=30
NEWS_POLL_REST_MAX_MINUTES=60
NEWS_POLL_BACKOFF_MINUTES=30

# 可选：官网 403 时自动切换到下一个固定节点（compose 内部地址即可）
# NEWS_POLL_NODE_API=http://mihomo:9090
# NEWS_POLL_NODES=Japan A01,Japan A02,Japan A03

# ---- 出口节点与订阅自动更新（可选）----
# 订阅地址：填了才会启用定期自动更新（拉取时会优先走当前出口）
# MIHOMO_SUB_URL=https://example.com/api/v1/client/subscribe?token=...
# MIHOMO_SUB_INTERVAL_MINUTES=720
# MIHOMO_INCLUDE=Japan
# MIHOMO_EXCLUDE=将在
# MIHOMO_INCLUDE 留空表示订阅里的全部节点（推荐：由健康检查筛出真正可用的，不限地区）
# MIHOMO_LISTENER_PORT_BASE=7901

# 节点健康检查间隔（分钟）；轮询每趟从「最近一次探测为 200」的节点里随机挑一个
# NODE_HEALTH_INTERVAL_MINUTES=30
# NODE_HEALTH_BAD_BATCH=6          # 每轮额外轮换探测多少个不可用节点
# NODE_HEALTH_PROBE_DELAY_SECONDS=4
