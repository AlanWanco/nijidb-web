# 复制为 news-poller.env，填写运行时值并保持文件权限 600；不要提交真实值。

# Nijidb 站点地址与新闻资源密钥（必填）
NIJIDB_BASE_URL=https://your-site.example
NIJIDB_INGEST_API_KEY=change-me

# R2 图片归档（必填；使用只允许目标 Bucket 对象读写的专用凭据）
R2_ENDPOINT=https://change-me.r2.cloudflarestorage.com
R2_BUCKET=nijidb
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_PUBLIC_BASE_URL=https://change-me
R2_IMAGE_PREFIX=images

# 轮询节奏：默认只扫官网第一页，篇间 30 秒、图间 10 秒，趟间隔随机 30–60 分钟
NEWS_POLL_MAX_PAGES=1
NEWS_POLL_ARTICLE_DELAY_SECONDS=30
NEWS_POLL_IMAGE_DELAY_SECONDS=10
NEWS_POLL_REST_MIN_MINUTES=30
NEWS_POLL_REST_MAX_MINUTES=60
NEWS_POLL_BACKOFF_MINUTES=30
